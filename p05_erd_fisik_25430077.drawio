        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    MAHASISWA ||--o{ KRS : mengisi\n    SEMESTER ||--o{ KRS : digunakan\n    MATA_KULIAH ||--o{ KELAS_KULIAH : dibuka\n    DOSEN ||--o{ KELAS_KULIAH : mengajar\n    SEMESTER ||--o{ KELAS_KULIAH : berlangsung\n    KRS ||--o{ DETAIL_KRS : memiliki\n    KELAS_KULIAH ||--o{ DETAIL_KRS : dipilih\n    DETAIL_KRS ||--o| NILAI : memiliki\n\n    MAHASISWA {\n        varchar NIM PK\n        varchar nama\n        varchar alamat\n        varchar no_hp\n    }\n\n    MATA_KULIAH {\n        varchar kode_mk PK\n        varchar nama_mk\n        tinyint sks\n    }\n\n    DOSEN {\n        varchar nidn PK\n        varchar nama_dosen\n    }\n\n    SEMESTER {\n        int id_semester PK\n        varchar tahun_ajaran\n        enum semester_ke\n    }\n\n    KELAS_KULIAH {\n        int id_kelas PK\n        varchar kode_mk FK\n        varchar nidn FK\n        int id_semester FK\n    }\n\n    KRS {\n        int id_krs PK\n        varchar NIM FK\n        int id_semester FK\n        date tanggal_pengisian\n    }\n\n    DETAIL_KRS {\n        int id_krs PK, FK\n        int id_kelas PK, FK\n        date tanggal_pemilihan\n    }\n\n    NILAI {\n        int id_krs PK, FK\n        int id_kelas PK, FK\n        decimal nilai_akhir\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y0O9fKR9nOReHtJHqVJ1-1">
