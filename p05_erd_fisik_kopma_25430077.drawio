        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    PETUGAS {\n        SMALLINT id_petugas PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        CHAR_3 kode_petugas UK \&quot;NOT NULL\&quot;\n        VARCHAR_100 nama_petugas \&quot;NOT NULL\&quot;\n        ENUM_kasir_gudang_ketua peran_petugas \&quot;NOT NULL\&quot;\n    }\n\n    BARANG {\n        INT id_barang PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        VARCHAR_10 kode_barang UK \&quot;NOT NULL\&quot;\n        VARCHAR_100 nama_barang \&quot;NOT NULL\&quot;\n        ENUM_ATK_makanan_minuman kategori_barang \&quot;NOT NULL\&quot;\n        DECIMAL_12_2 harga_jual_barang \&quot;NOT NULL CHECK &gt;= 0\&quot;\n        INT stok_barang \&quot;NOT NULL DEFAULT 0 CHECK &gt;= 0\&quot;\n        INT stok_min_barang \&quot;NOT NULL DEFAULT 5\&quot;\n    }\n\n    ANGGOTA {\n        INT id_anggota PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        CHAR_6 no_anggota UK \&quot;NOT NULL\&quot;\n        CHAR_10 nim_anggota UK \&quot;NOT NULL\&quot;\n        VARCHAR_100 nama_anggota \&quot;NOT NULL\&quot;\n        VARCHAR_60 prodi_anggota \&quot;NOT NULL\&quot;\n        VARCHAR_15 no_hp_anggota \&quot;NULL\&quot;\n        ENUM_aktif_nonaktif status_anggota \&quot;NOT NULL DEFAULT aktif\&quot;\n        DATE tgl_daftar_anggota \&quot;NOT NULL\&quot;\n    }\n\n    PEMASOK {\n        INT id_pemasok PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        VARCHAR_100 nama_pemasok \&quot;NOT NULL\&quot;\n        VARCHAR_15 telepon_pemasok \&quot;NULL\&quot;\n        VARCHAR_200 alamat_pemasok \&quot;NULL\&quot;\n    }\n\n    PENJUALAN {\n        INT id_penjualan PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        CHAR_12 no_nota_penjualan UK \&quot;NOT NULL\&quot;\n        DATETIME tgl_penjualan \&quot;NOT NULL\&quot;\n        SMALLINT id_petugas FK \&quot;NOT NULL\&quot;\n        INT id_anggota FK \&quot;NULL\&quot;\n        DECIMAL_12_2 bayar_penjualan \&quot;NOT NULL\&quot;\n    }\n\n    DETAIL_PENJUALAN {\n        INT id_penjualan PK, FK \&quot;NOT NULL\&quot;\n        INT id_barang PK, FK \&quot;NOT NULL\&quot;\n        SMALLINT qty_detail_penjualan \&quot;NOT NULL CHECK &gt; 0\&quot;\n        DECIMAL_12_2 harga_satuan_detail_penjualan \&quot;NOT NULL\&quot;\n    }\n\n    PEMBELIAN {\n        INT id_pembelian PK \&quot;AUTO_INCREMENT NOT NULL\&quot;\n        VARCHAR_20 no_faktur_pembelian \&quot;NOT NULL\&quot;\n        DATE tgl_pembelian \&quot;NOT NULL\&quot;\n        INT id_pemasok FK \&quot;NOT NULL\&quot;\n        ENUM_dipesan_diterima status_pembelian \&quot;NOT NULL DEFAULT dipesan\&quot;\n    }\n\n    DETAIL_PEMBELIAN {\n        INT id_pembelian PK, FK \&quot;NOT NULL\&quot;\n        INT id_barang PK, FK \&quot;NOT NULL\&quot;\n        INT qty_detail_pembelian \&quot;NOT NULL CHECK &gt; 0\&quot;\n        DECIMAL_12_2 harga_beli_detail_pembelian \&quot;NOT NULL\&quot;\n    }\n\n    PETUGAS ||--o{ PENJUALAN : mencatat\n    ANGGOTA o|--o{ PENJUALAN : melakukan\n    PENJUALAN ||--|{ DETAIL_PENJUALAN : memiliki\n    BARANG ||--o{ DETAIL_PENJUALAN : dicatat_dalam\n    PEMASOK ||--o{ PEMBELIAN : memasok\n    PEMBELIAN ||--o{ DETAIL_PEMBELIAN : memiliki\n    BARANG ||--o{ DETAIL_PEMBELIAN : dicatat_dalam\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="uFlsj0vxo6I_mlizL9JB-1">
